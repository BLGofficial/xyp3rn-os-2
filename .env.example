# Copy to .env.local (never committed).
# XYP3RN OS 3.0 Local-First Configuration (external Vault path; never hardcode machine-specific paths in code)
OBSIDIAN_VAULT_PATH=../XYP3RN-OS3-Vault
OBSIDIAN_SYNC_MODE=bidirectional
XYP_SQLITE_PATH=.local-db/xyp3rn-os3.sqlite
XYP_GATEWAY_PORT=8077

# Legacy OS 2.0 PostgreSQL fallback — RETIRED IN OS 3.0 (uncomment only for legacy rollback)
# XYP_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Phase 8 LLM providers, read from the process environment (nothing loads .env automatically): an
# agent's frontmatter `model` picks the provider, and only that provider's key is needed.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# Phase 9 Suno reseller adapter (sunoapi.org; unofficial). Only needed for adapter "sunoapi"; "manual" needs nothing.
# SUNO_API_KEY=
# SUNO_CALLBACK_URL=

# Studio voice: set in the web process or apps/web/.env.local. Wispr Flow uses the focused text field.
# Optional browser transcription (configure exact service/model/languages before enabling):
# XYP_WHISPER_URL=http://127.0.0.1:9000/v1/audio/transcriptions
# XYP_WHISPER_MODEL=
# XYP_WHISPER_LANGUAGES=en,bg
# XYP_WHISPER_API_KEY=
# Local Kokoro read-back (English verified locally; do not declare unsupported languages):
# XYP_KOKORO_URL=http://127.0.0.1:8880/v1/audio/speech
# XYP_KOKORO_MODEL=kokoro
# XYP_KOKORO_VOICE=af_bella
# XYP_KOKORO_LANGUAGES=en
# XYP_KOKORO_API_KEY=
