{
  "name": "xyp3rn-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "XYP3RN Agentic OS 2 — six-domain agent operating system (monorepo root).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:setup": "./supabase/local/setup.sh",
    "db:up": "node core/db/cli.ts up",
    "db:down": "node core/db/cli.ts down",
    "db:status": "node core/db/cli.ts status",
    "db:seed:proof": "node supabase/seed/run-fk-proof.ts",
    "ingest": "node knowledge/ingestion/cli.ts",
    "embed": "node knowledge/vector-retrieval/cli.ts",
    "context": "node core/context-engine/cli.ts",
    "agents:validate": "node core/agent-registry/cli.ts",
    "dispatch": "node core/orchestrator/cli.ts",
    "route": "node core/orchestrator/route-cli.ts",
    "workflow": "node core/workflow-engine/cli.ts",
    "ask": "node core/orchestrator/ask-cli.ts",
    "jarvis": "node core/src/cli/jarvis-entry.ts",
    "start:os": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-xyp3rn.ps1",
    "specialists:table": "node research-intelligence/specialists/table-cli.ts",
    "research": "node research-intelligence/cli.ts",
    "gate": "node knowledge/promotion-gate/cli.ts",
    "evaluate": "node records/x3lius/evaluation/cli.ts",
    "trace:serve": "node tech/trace/serve-cli.ts",
    "trace:schemas": "node tech/trace/schemas-cli.ts",
    "vault": "node records/vault/cli.ts",
    "index": "node knowledge/knowledge-graph/cli.ts",
    "audit:system": "pnpm typecheck && pnpm test && pnpm agents:validate",
    "obsidian:export":"node --env-file-if-exists=.env.local knowledge/obsidian/exporter-cli.ts",
    "obsidian:watch":"node --env-file-if-exists=.env.local core/obsidian/watcher-cli.ts",
    "studio": "node records/x3lius/studio/cli.ts",
    "web": "pnpm --filter @xyp3rn/web start",
    "web:build": "pnpm --filter @xyp3rn/web build",
    "web:smoke": "node apps/web/e2e/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@huggingface/transformers": "^4.3.0",
    "chokidar": "^5.0.0",
    "postgres": "^3.4.9",
    "typescript-api": "npm:typescript@5.9.3",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.28"
    },
    "ignoredBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs"
    ]
  }
}
